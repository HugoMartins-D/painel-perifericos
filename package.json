{
  "name": "painel-perifericos",
  "productName": "Painel de PerifÃ©ricos",
  "version": "1.2.0",
  "description": "Mostra a configuraÃ§Ã£o do mouse Razer e do teclado Marvo",
  "author": "Hugo",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
